# Token do bot, gerado em https://discord.com/developers/applications (aba "Bot" > Reset Token / Copy)
DISCORD_TOKEN=

# Client ID e Client Secret do MESMO app Discord (aba "OAuth2" > General).
# Usados para o login "Entrar com Discord" na interface web (nao confundir
# com o token do bot nem com a chave publica).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL de callback do OAuth. Precisa estar cadastrada EXATAMENTE assim em
# OAuth2 > Redirects no Developer Portal. Se voce estiver testando por um
# tunel (ngrok etc), use a URL publica do tunel + /auth/discord/callback, e
# atualize aqui e no Developer Portal toda vez que a URL do tunel mudar.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# URL publica onde a interface web esta acessivel (mesma raiz do tunel/deploy).
# Usada para redirecionar de volta pro app depois do login com Discord.
WEB_ORIGIN=http://localhost:3000

# Credenciais do app Spotify, geradas em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Porta do servidor web/API
PORT=3000
